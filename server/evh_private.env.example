# Configuration privée du backend PHP (formulaire Eden).
#
# Ce fichier se copie sur le serveur sous le nom « .env » dans le dossier
# evh_private, placé À CÔTÉ de public_html et jamais dedans :
#
#   domains/vasesdhonneurchicoutimi.org/
#     public_html/      (le contenu de dist/)
#     evh_private/
#       .env            (ce fichier, rempli)
#
# Ne le mettez jamais dans Git une fois rempli : il contient des mots de passe.

APP_ENV=production

# ---------------------------------------------------------------------------
# Base de données MySQL (hPanel > Bases de données > Gestion)
# Remplacez u123456789_eden par le nom réel de la base et de l'utilisateur.
DB_DSN="mysql:host=localhost;dbname=u123456789_eden;charset=utf8mb4"
DB_USER=u123456789_eden
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Envoi des courriels : expéditeur eden@vasesdhonneurchicoutimi.org, acheminé par
# Brevo (relais transactionnel). Le relais SMTP partagé d'Hostinger est refusé
# par certains serveurs, dont celui de evhca.com (Titan) : voir server/README.md.
# MAIL_DRIVER : smtp (production), log (tests : rien n'est envoyé, les messages
# sont écrits dans evh_private/logs/mail), mail (dépannage seulement).
MAIL_DRIVER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=tls
# Identifiant et clé : Brevo > SMTP & API > onglet SMTP (« Generate SMTP key »).
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'un domaine authentifié dans Brevo et déclarée comme expéditeur.
MAIL_FROM=eden@vasesdhonneurchicoutimi.org
MAIL_FROM_NAME="Eden, Vases d'Honneur Chicoutimi"

# ---------------------------------------------------------------------------
# Eden
# Destinataires des inscriptions (plusieurs adresses : séparées par des virgules).
# EDEN_EMAIL_BCC (copie cachée) ne concerne que le courriel envoyé à l'équipe.
# Aucune adresse n'est écrite dans le code : sans EDEN_EMAIL_TO, rien ne part
# vers l'équipe (l'inscription reste enregistrée et l'erreur est journalisée).
#
# PHASE DE TEST : tout arrive à une seule adresse, sans copie.
EDEN_EMAIL_TO=adresse.de.test@exemple.com
EDEN_EMAIL_CC=
EDEN_EMAIL_BCC=
#
# MISE EN SERVICE : une fois les tests validés, remplacer les trois lignes
# ci-dessus par celles-ci (enlever le # au début) :
# EDEN_EMAIL_TO=eden1coach@evhca.com
# EDEN_EMAIL_CC=wlogan.wilfried@yahoo.fr
# EDEN_EMAIL_BCC=vasesdhonneurchicoutimi@gmail.com

# Informations rappelées dans le courriel envoyé au candidat.
# Elles doivent rester identiques à celles de src/data/eden.js (affichées sur le site).
EDEN_FRAIS=250
EDEN_INTERAC_EMAIL=eden1@evhca.com
EDEN_WHATSAPP="+1 (581) 574-4660"
EDEN_INFOLINE="+1 (418) 490-0186"
EDEN_DEBUT_COURS="à partir du mardi 20 octobre 2026, en ligne sur Zoom"

# Nombre maximum d'envois du formulaire par heure et par connexion.
EDEN_LIMITE_PAR_HEURE=10

# Origines autorisées à envoyer le formulaire (le domaine du site est déjà
# autorisé automatiquement ; à compléter seulement si besoin).
ALLOWED_ORIGINS=https://vasesdhonneurchicoutimi.org,https://www.vasesdhonneurchicoutimi.org
