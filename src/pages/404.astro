---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page introuvable | Église Vases d'Honneur Chicoutimi"
  description="Cette page n'existe pas ou a été déplacée."
  noindex
>

  <section class="page-hero">
    <p class="breadcrumb"><a href="/">Accueil</a> <span>›</span> Page introuvable</p>
    <h1>Page <span class="accent">introuvable</span></h1>
    <p class="page-hero-lead">
      La page que vous cherchez n'existe pas ou a été déplacée.
      Vous pouvez revenir à l'accueil ou consulter nos horaires de culte.
    </p>
    <div class="hero-cta">
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
      <a href="/#horaires" class="btn btn-ghost">Nos cultes</a>
    </div>
  </section>

</BaseLayout>
