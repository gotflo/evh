---
import BaseLayout from '../layouts/BaseLayout.astro';

// Galerie, clé : { full, thumb, alt }
// Les vignettes (thumb) et les versions plein écran (full) sont générées
// en WebP optimisé. Layout masonry : chaque photo garde ses proportions,
// aucune image n'est recadrée.
const G = '/img/Gallery';
const items = [
  { full: `${G}/P1081834-full.webp`, thumb: `${G}/P1081834-thumb.webp`, alt: 'Culte à l\'assemblée' },
  { full: `${G}/P1081636-full.webp`, thumb: `${G}/P1081636-thumb.webp`, alt: 'Temps de louange' },
  { full: `${G}/P1081801-full.webp`, thumb: `${G}/P1081801-thumb.webp`, alt: 'Moment de communion' },
  { full: `${G}/P1081377-full.webp`, thumb: `${G}/P1081377-thumb.webp`, alt: 'Vie d\'assemblée' },
  { full: `${G}/P1071292-full.webp`, thumb: `${G}/P1071292-thumb.webp`, alt: 'Rassemblement fraternel' },
  { full: `${G}/P1071049-full.webp`, thumb: `${G}/P1071049-thumb.webp`, alt: 'Célébration à l\'église' },
  { full: `${G}/P1071047-full.webp`, thumb: `${G}/P1071047-thumb.webp`, alt: 'Adoration et prière' },
  { full: `${G}/P1085879-full.webp`, thumb: `${G}/P1085879-thumb.webp`, alt: 'Moment de culte à l\'assemblée' },
  { full: `${G}/P1086112-full.webp`, thumb: `${G}/P1086112-thumb.webp`, alt: 'Temps de louange et d\'adoration' },
  { full: `${G}/P1086402-full.webp`, thumb: `${G}/P1086402-thumb.webp`, alt: 'Rassemblement de l\'assemblée' },
  { full: `${G}/P1086458-full.webp`, thumb: `${G}/P1086458-thumb.webp`, alt: 'Vie d\'assemblée' },
  { full: `${G}/P1086582-full.webp`, thumb: `${G}/P1086582-thumb.webp`, alt: 'Prière et recueillement' },
  { full: `${G}/P1086693-full.webp`, thumb: `${G}/P1086693-thumb.webp`, alt: 'Célébration du dimanche' },
  { full: `${G}/P1086738-full.webp`, thumb: `${G}/P1086738-thumb.webp`, alt: 'Communion fraternelle' },
  { full: `${G}/P1086820-full.webp`, thumb: `${G}/P1086820-thumb.webp`, alt: 'Moment de partage' },
  { full: `${G}/P1086908-full.webp`, thumb: `${G}/P1086908-thumb.webp`, alt: 'Louange, mains levées' },
  { full: `${G}/P1086913-full.webp`, thumb: `${G}/P1086913-thumb.webp`, alt: 'Adoration à l\'assemblée' },
  { full: `${G}/P1044961-full.webp`, thumb: `${G}/P1044961-thumb.webp`, alt: 'Vie de l\'église' },
  { full: `${G}/P1045151-full.webp`, thumb: `${G}/P1045151-thumb.webp`, alt: 'Vie de l\'église' },
  { full: `${G}/P1086400-full.webp`, thumb: `${G}/P1086400-thumb.webp`, alt: 'Événement de l\'assemblée' },
  { full: `${G}/P1086441-full.webp`, thumb: `${G}/P1086441-thumb.webp`, alt: 'Événement de l\'assemblée' },
  { full: `${G}/7I0A0118-full.jpg`, thumb: `${G}/7I0A0118-thumb.jpg`, alt: 'Moment de culte' },
  { full: `${G}/7I0A0133-full.jpg`, thumb: `${G}/7I0A0133-thumb.jpg`, alt: 'Louange et adoration' },
  { full: `${G}/7I0A3118-full.jpg`, thumb: `${G}/7I0A3118-thumb.jpg`, alt: 'Vie d\'assemblée' },
  { full: `${G}/385744452_806068568188038_1097952417221916540_n-1536x1023.jpg`, thumb: `${G}/385744452_806068568188038_1097952417221916540_n-1024x682.jpg`, alt: 'Prédication, partager l\'amour' },
];
---

<BaseLayout
  title="Galerie, Vases d'Honneur Chicoutimi"
  description="Galerie photo de l'Église Vases d'Honneur Chicoutimi, cultes, louange, événements, vie d'assemblée."
  active="galerie"
>

  <section class="page-hero">
    <p class="breadcrumb"><a href="/index.html">Accueil</a> <span>›</span> Galerie</p>
    <h1>La vie de <span class="accent">l'assemblée</span></h1>
    <p class="page-hero-lead">
      Au fil des cultes, des soirées de prière et des moments fraternels,
      des instants saisis dans la maison.
    </p>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="gallery-grid reveal">
        {items.map((it) => (
          <div class="gallery-item" data-full={it.full}>
            <img src={it.thumb} alt={it.alt} loading="lazy" />
          </div>
        ))}
      </div>

      <p class="reveal" style="text-align:center; margin-top: 3rem; color: var(--text-soft); font-size: 0.9rem;">
        Clique sur une image pour l'agrandir · Échap pour fermer
      </p>
    </div>
  </section>

</BaseLayout>
